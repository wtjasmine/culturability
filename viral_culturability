read_virus <- function(file, sheet) {
  read_excel(file, sheet = sheet) %>%
    mutate(
      Cov.id = factor(Cov.id),
      Days_from_onset = as.numeric(Days_from_onset),
      Culture_positive = as.numeric(Culture_positive),
      N = as.numeric(N),
      Culture_negative = N - Culture_positive
    ) %>%
    filter(
      !is.na(Cov.id),
      !is.na(Days_from_onset),
      !is.na(Culture_positive),
      !is.na(N),
      N > 0,
      Culture_positive >= 0,
      Culture_positive <= N
    ) %>%
    droplevels()
}


fit_model <- function(formula, data, link = "logit") {
  glmer(
    formula,
    data = data,
    family = binomial(link = link),
    control = glmerControl(
      optimizer = "bobyqa",
      optCtrl = list(maxfun = 2e5)
    )
  )
}


# Fixed-effect estimates with Wald 95% CI
extract_fixed <- function(model, name) {
  coefs <- summary(model)$coefficients
  ci <- confint(model, parm = "beta_", method = "Wald")

  data.frame(
    Model = name,
    Parameter = rownames(coefs),
    Estimate = round(coefs[, "Estimate"], 3),
    Lower_95CI = round(ci[rownames(coefs), 1], 3),
    Upper_95CI = round(ci[rownames(coefs), 2], 3),
    P_value = signif(coefs[, "Pr(>|z|)"], 3),
    row.names = NULL
  )
}


# Random-effect SD and correlation
extract_random <- function(model, name) {
  re <- as.data.frame(VarCorr(model))

  data.frame(
    Model = name,
    Parameter = ifelse(
      is.na(re$var2),
      paste0(re$var1, " SD"),
      paste(re$var1, re$var2, "Correlation", sep = " / ")
    ),
    Value = round(re$sdcor, 3),
    row.names = NULL
  )
}


# Fixed-effect predictions with approximate 95% CI
predict_curve <- function(model, newdata) {
  fixed_formula <- lme4::nobars(formula(model))

  X <- model.matrix(
    delete.response(terms(fixed_formula)),
    data = newdata
  )

  beta <- fixef(model)
  V <- as.matrix(vcov(model))

  X <- X[, names(beta), drop = FALSE]
  V <- V[names(beta), names(beta), drop = FALSE]

  eta <- as.vector(X %*% beta)
  se <- sqrt(pmax(0, rowSums((X %*% V) * X)))

  linkinv <- family(model)$linkinv

  newdata$pred <- linkinv(eta)
  newdata$lower <- linkinv(eta - 1.96 * se)
  newdata$upper <- linkinv(eta + 1.96 * se)

  newdata
}


make_pred <- function(model, data, virus, end_day = 30) {
  newdata <- data.frame(
    Days_from_onset = seq(
      min(data$Days_from_onset),
      end_day,
      by = 0.1
    )
  )

  predict_curve(model, newdata) %>%
    mutate(Virus = virus)
}


aggregate_obs <- function(data, virus) {
  data %>%
    group_by(Days_from_onset) %>%
    summarise(
      Total_positive = sum(Culture_positive),
      Total_N = sum(N),
      Proportion = Total_positive / Total_N,
      .groups = "drop"
    ) %>%
    mutate(Virus = virus)
}


# Time at which prediction crosses threshold
crossing_day <- function(pred, column, threshold) {
  pred <- pred[order(pred$Days_from_onset), ]

  x <- pred$Days_from_onset
  y <- pred[[column]]

  if (length(x) == 0 || anyNA(y)) return(NA_real_)
  if (y[1] <= threshold) return(x[1])

  idx <- which(
    head(y, -1) > threshold &
      tail(y, -1) <= threshold
  )

  if (length(idx) == 0) return(NA_real_)

  i <- idx[1]

  x[i] + (threshold - y[i]) *
    (x[i + 1] - x[i]) / (y[i + 1] - y[i])
}


threshold_table <- function(pred, group) {
  bind_rows(lapply(c(0.05, 0.01), function(t) {
    data.frame(
      Group = group,
      Threshold = paste0(t * 100, "%"),
      Estimate_day = crossing_day(pred, "pred", t),
      Lower_band_crossing = crossing_day(pred, "lower", t),
      Upper_band_crossing = crossing_day(pred, "upper", t)
    )
  }))
}


