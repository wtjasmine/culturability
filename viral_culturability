  ),
  row.names = FALSE
)


# Calculate cloglog threshold results only if
# no convergence warning is reported.

if (is.null(cloglog_messages)) {
  
  pred_cloglog <- make_pred(
    Model_sars_cloglog,
    sars,
    "SARS-CoV-2 (cloglog)",
    end_day = 60
  )
  
  sensitivity_thresholds <- bind_rows(
    
    threshold_table(
      make_pred(
        Model_sars,
        sars,
        "SARS-CoV-2 (logit)",
        end_day = 60
      ),
      "Logit"
    ),
    
    threshold_table(
      pred_cloglog,
      "Cloglog"
    )
    
  )
  
  print(sensitivity_thresholds)
  
  write.csv(
    sensitivity_thresholds,
    file.path(
      output_dir,
      "cloglog_threshold_sensitivity.csv"
    ),
    row.names = FALSE
  )
  
} else {
  
  warning(
    "Cloglog convergence warning. ",
