study_curves <- function(model, virus) {
  study_ids <- levels(getME(model, "flist")$Cov.id)

  grid <- expand.grid(
    Days_from_onset = seq(0, 30, by = 0.1),
    Cov.id = study_ids
  )

  grid$Cov.id <- factor(grid$Cov.id, levels = study_ids)

  grid$pred <- predict(
    model,
    newdata = grid,
    type = "response",
    re.form = NULL
  )

  grid$Virus <- virus
  grid
}


