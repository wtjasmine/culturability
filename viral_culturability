fit_temporal <- function(data) {
  
  RI <- fit_model(
    cbind(Culture_positive, Culture_negative) ~
      Days_from_onset +
      (1 | Cov.id),
    data
  )
  
  RS <- fit_model(
    cbind(Culture_positive, Culture_negative) ~
      Days_from_onset +
      (Days_from_onset | Cov.id),
    data
  )
  
  list(
    RI = RI,
    RS = RS
  )
}


sars_fit <- fit_temporal(sars)
flu_fit <- fit_temporal(flu)
rsv_fit <- fit_temporal(rsv)


