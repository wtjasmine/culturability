# 13. CLOGLOG SENSITIVITY ANALYSIS
# NO PLOT
# ============================================================

Model_sars_cloglog <- fit_model(
  cbind(Culture_positive, Culture_negative) ~
    Days_from_onset +
    (Days_from_onset | Cov.id),
  sars,
  link = "cloglog"
)


# Check convergence

cloglog_messages <-
  Model_sars_cloglog@optinfo$conv$lme4$messages


print(cloglog_messages)


cloglog_comparison <- data.frame(
  
  Model = c(
    "Logit (primary)",
    "Cloglog (sensitivity)"
  ),
  
  AIC = round(
    c(
      AIC(Model_sars),
      AIC(Model_sars_cloglog)
    ),
    1
  ),
  
  BIC = round(
    c(
      BIC(Model_sars),
      BIC(Model_sars_cloglog)
    ),
    1
  ),
  
  Singular_fit = c(
    isSingular(Model_sars),
    isSingular(Model_sars_cloglog)
  ),
  
  Convergence_warning = c(
    !is.null(Model_sars@optinfo$conv$lme4$messages),
    !is.null(cloglog_messages)
  )
  
)


print(cloglog_comparison)


write.csv(
  cloglog_comparison,
