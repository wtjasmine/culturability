read_virus <- function(file, sheet) {
  
  read_excel(file, sheet = sheet) %>%
    mutate(
      Cov.id = factor(Cov.id),
      Days_from_onset = as.numeric(Days_from_onset),
      Culture_positive = as.numeric(Culture_positive),
      N = as.numeric(N),
      Culture_negative = N - Culture_positive
    ) %>%
    filter(
      !is.na(Cov.id),
      !is.na(Days_from_onset),
      !is.na(Culture_positive),
      !is.na(N),
      N > 0,
      Culture_positive >= 0,
      Culture_positive <= N
    )
}


fit_model <- function(formula, data, link = "logit") {
  
  glmer(
    formula,
    data = data,
    family = binomial(link = link),
    control = glmerControl(
      optimizer = "bobyqa",
      optCtrl = list(maxfun = 2e5)
    )
  )
}


lrt <- function(simple, complex) {
  
  stopifnot(
    identical(
      rownames(model.frame(simple)),
      rownames(model.frame(complex))
    )
  )
  
  as.numeric(
    anova(simple, complex)$`Pr(>Chisq)`[2]
  )
}


format_p <- function(p) {
  
  if (is.na(p)) return("—")
  
  if (p < 0.001) return("<0.001")
  
  sprintf("%.4f", p)
}


# Fixed-effect prediction with approximate 95% CI

predict_curve <- function(model, newdata) {
  
  fixed_formula <- lme4::nobars(formula(model))
  
  X <- model.matrix(
    delete.response(terms(fixed_formula)),
    data = newdata
  )
  
  beta <- fixef(model)
  V <- as.matrix(vcov(model))
  
  X <- X[, names(beta), drop = FALSE]
  V <- V[names(beta), names(beta), drop = FALSE]
  
  eta <- as.vector(X %*% beta)
  
  se <- sqrt(
    pmax(0, rowSums((X %*% V) * X))
  )
  
  linkinv <- family(model)$linkinv
  
  newdata$pred <- linkinv(eta)
  newdata$lower <- linkinv(eta - 1.96 * se)
  newdata$upper <- linkinv(eta + 1.96 * se)
  
  newdata
}


aggregate_obs <- function(data, virus) {
  
  data %>%
    group_by(Days_from_onset) %>%
    summarise(
      Total_positive = sum(Culture_positive),
      Total_N = sum(N),
      Proportion = Total_positive / Total_N,
      .groups = "drop"
    ) %>%
    mutate(Virus = virus)
}


make_pred <- function(model, data, virus, end_day = 30) {
  
  newdata <- data.frame(
    Days_from_onset = seq(
      min(data$Days_from_onset),
      end_day,
      by = 0.1
    )
  )
  
  predict_curve(model, newdata) %>%
    mutate(Virus = virus)
}


crossing_day <- function(pred, column, threshold) {
  
  pred <- pred[order(pred$Days_from_onset), ]
  
  x <- pred$Days_from_onset
  y <- pred[[column]]
  
  if (length(x) == 0 || anyNA(y)) {
    return(NA_real_)
  }
  
  if (y[1] <= threshold) return(x[1])
  
  idx <- which(
    head(y, -1) > threshold &
      tail(y, -1) <= threshold
  )
  
  if (length(idx) == 0) return(NA_real_)
  
  i <- idx[1]
  
  x[i] + (threshold - y[i]) *
    (x[i + 1] - x[i]) /
    (y[i + 1] - y[i])
}


threshold_table <- function(pred, virus) {
  
  bind_rows(
    lapply(c(0.05, 0.01), function(t) {
      
      data.frame(
        Virus = virus,
        Threshold = paste0(t * 100, "%"),
        Estimate_day = crossing_day(pred, "pred", t),
        Lower_band_crossing = crossing_day(
          pred, "lower", t
        ),
        Upper_band_crossing = crossing_day(
          pred, "upper", t
        )
      )
      
    })
  )
}


